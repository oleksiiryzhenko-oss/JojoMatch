{
  "expo": {
    "name": "JojoMatch",
    "slug": "jojomatch",
    "scheme": "jojomatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#06110C"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#06110C"
      },
      "package": "com.jojjjjjomaatcchh",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ],
      "googleServicesFile": "./app/google-services.json",
      "blockedPermissions": [
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-asset",
      "@react-native-community/datetimepicker",
      "@react-native-firebase/app",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Fotoğraf çekmek için kamera erişimine izin ver."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "minSdkVersion": 24,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#FFC414"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b2680c6b-3e80-4cb4-af1c-a46dc187077f"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/b2680c6b-3e80-4cb4-af1c-a46dc187077f"
    },
    "owner": "alex_react-natuve",
    "platforms": [
      "android"
    ],
    "backgroundColor": "#06110C"
  }
}
